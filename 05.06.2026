# Flow pattern code

from codrone_edu.swarm import *
swarm = Swarm(enable_pause=False)

def drone_count(): # returns number of drones
    drone_index = 0
    try:
        while True:
            print(swarm.run_drone(drone_index, "get_position_data"))
            drone_index += 1
    except:
        return drone_index

def flowing_pattern(loops, r, g, b, brightness): # creates a flowing pattern
    swarm.set_drone_LED(0, 0, 0, 0)
    total = drone_count()
    print("Starting flowing pattern for", total, "drones.")
    delay = 1.5 # this changes delay between each light

    for i in range(loops):
        print(loops)
        for index in range(total):
            swarm.run_drone(index, 'set_drone_LED', r, g, b, brightness)
            print(f"{index} on and ",end="")
            index = (index + total//2) % total
            swarm.run_drone(index, 'set_drone_LED', r, g, b, 0)
            print(f"{index} off.")
            swarm.hover(delay)
    print("Flowing pattern finished.")

def main():
    swarm.connect()
    flowing_pattern(2, 'blue')
    swarm.disconnect()



import socket
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.bind(('0.0.0.0', 0000))  # Listen on all interfaces, port 0000
s.listen(1)

print("Waiting for input from another computer...")
conn, addr = s.accept()  # This line PAUSES the code until someone connects
print(f"Connected by {addr}")

data = conn.recv(1024)   # This line PAUSES until data is sent
print(f"Received message: {data.decode()}")
if {data.decode()} == "go":
    import 

conn.close()





